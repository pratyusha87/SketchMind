# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-64-random-chars

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Go to: Google Account → Security → 2FA → App Passwords → generate for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=yourgmail@gmail.com

# ── AI Image Generation (at least one required for real images) ───────────────
# Option A: OpenAI DALL-E 3  → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Option B: Hugging Face     → https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# If both are empty, dev mode returns placeholder images so UI still works.
